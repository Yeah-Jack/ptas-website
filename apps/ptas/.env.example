MAILJET_APIKEY_PUBLIC=your_api_key_here
MAILJET_APIKEY_PRIVATE=your_secret_key_here

# Required for `bun run dev`: your own address(es), comma-separated. They
# replace info@ptas.de and sales as recipients of contact form emails.
# Never set this in the Azure production environment.
CONTACT_EMAIL_TO=you@ptas.de
