{
	"name": "ptas-website",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"lint": "biome check --write .",
		"start": "turbo run start",
		"test": "turbo run test",
		"test:watch": "turbo run test:watch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"lefthook": "2.2.2",
		"turbo": "2.11.11"
	},
	"packageManager": "bun@1.4.2",
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2",
			"onFail": "warn"
		}
	}
}
