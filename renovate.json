{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:best-practices", "group:allNonMajor"],
	"labels": ["dependencies"],
	"minimumReleaseAge": "3 days",
	"schedule": ["* 0-8 * * 1"],
	"separateMultipleMajor": true,
	"timezone": "Europe/Berlin",
	"vulnerabilityAlerts": {
		"addLabels": ["security"],
		"enabled": true
	}
}
